# REQUIRED
PORT=4002
NODE_ENV=development

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=checkout_db

# jwt
CORS_ORIGINS=*
JWT_SECRET=jwt-secret-key
JWT_EXPIRES_IN=24h

# services
PAYMENTS_SERVICE_URL=http://localhost:4003
PRODUCTS_SERVICE_URL=http://localhost:4004
USERS_SERVICE_URL=http://localhost:4005

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin@localhost:5672
RABBITMQ_QUEUE_PAYMENTS=payments_queue
RABBITMQ_EXCHANGE=payments
